{
  "name": "routevfx",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Mobile-first PWA: multimodale Reiserouten animieren und als 9:16-MP4 exportieren (Prototyp, nicht veröffentlicht).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:functions": "deno check supabase/functions/route/index.ts docs/supabase/route-function-single-file.ts",
    "build:function-single-file": "node scripts/build-function-single-file.mjs",
    "data:build": "node scripts/build-geodata.mjs"
  },
  "dependencies": {
    "idb": "8.0.4",
    "maplibre-gl": "6.13.0",
    "mediabunny": "1.61.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@maplibre/maplibre-gl-style-spec": "26.4.4",
    "@playwright/test": "1.64.0",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "deno": "2.9.6",
    "fake-indexeddb": "6.2.5",
    "geojson-vt": "4.0.2",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vt-pbf": "3.1.3"
  }
}
